# PostgreSQL connection string (required — the app throws on boot without it)
DATABASE_URL=postgresql://user:password@localhost:5432/robotat
PORT=5000

# Session signing secret — use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# --- Assessment delivery: email (optional; logs to console if unset) ---
# Email transport. Two ways to send; the first one set wins.
#
# 1. HTTPS (preferred). Delivery over port 443, which no platform blocks, plus per-message
#    delivery logs and bounce reporting. Required on hosts that block outbound SMTP —
#    Railway drops 25, 465 and 587 alike, and reports it only as "Connection timeout".
#    Verify your sending domain with the provider first, or every send returns 422.
# RESEND_API_KEY=re_...
#
# 2. SMTP. Fine anywhere outbound SMTP is permitted. Ignored when RESEND_API_KEY is set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=robotat@nasl-tech.com
# SMTP_PASS=
# ASSESSMENT_INBOX=assessments@nasl-tech.com

# The address customers see in From:. Defaults to SMTP_USER, which is right for Gmail
# and wrong for a transactional provider, where SMTP_USER is an API key or a provider
# username rather than an address. A display name is fine:
#   MAIL_FROM="ROBOTAT <hello@nasl-tech.com>"
# MAIL_FROM=

# Divert EVERY outgoing email to one address instead of its real recipient. The
# intended address is prefixed onto the subject, e.g.
#   [-> customer@somefarm.sa] Reset your ROBOTAT password
# For exercising a live SMTP setup without mailing real customers. REFUSED IN
# PRODUCTION: it would mean no customer receives a booking confirmation, status
# update, password reset or verification link, while the logs still say mail went out.
# MAIL_REDIRECT_TO=

# --- Assessment delivery: WhatsApp ---
# The number that receives new-booking alerts, in full international form, digits
# only. The value below is a placeholder, not a real line — it keeps the
# click-to-chat link well-formed in development. Change it before enabling the
# Cloud API, or alerts will be sent to nobody (flagged at boot).
WHATSAPP_BUSINESS_NUMBER=966500000000
# Optional WhatsApp Cloud API push (from Meta) — click-to-chat works without these
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# Name of the template approved in the WhatsApp Manager for the business's own
# new-booking alert, e.g. robotat_new_booking. Same 24-hour rule as the status
# template below, and it bites harder here: nobody messages the business line to ask
# for its own alerts, so the window is essentially always shut and plain text always
# fails with error 131047. Five body parameters:
#   {{1}} customer name   {{2}} booking ref   {{3}} phone / email
#   {{4}} land size and location   {{5}} the customer's message
# WHATSAPP_BOOKING_TEMPLATE=

# Name of the message template approved in the WhatsApp Manager, e.g.
# robotat_status_update. REQUIRED IN PRODUCTION: a status change is a
# business-initiated message, and Meta only delivers plain text inside the 24-hour
# window opened by the customer's own last message. Outside it the send fails with
# error 131047 and the customer is never told their visit was scheduled. Left unset,
# delivery falls back to plain text, which is fine locally and broken in production.
# The template takes three body parameters: {{1}} name, {{2}} booking ref, {{3}} status.
# WHATSAPP_STATUS_TEMPLATE=
# Language code the template was registered under. Defaults to "en".
# WHATSAPP_TEMPLATE_LANG=en

# --- Native iOS app (Capacitor) ---
# Build-time only (baked into the client bundle, so it must start with VITE_).
# Absolute HTTPS origin of the deployed backend the native app should call. Leave
# UNSET for web/dev builds (the client uses same-origin relative /api paths).
# Nothing validates this: it is baked in as a plain string, so an origin that does
# not resolve produces no build error whatsoever — just an app that looks entirely
# normal and fails every API call at DNS lookup, on a device, after you have shipped
# it. Check the value serves /api/products before building a release:
#   curl -sS -o /dev/null -w '%{http_code}\n' https://robotat.sa/api/products
# robotat.sa is registered to NASL but, as of the last check, has no A record and
# does not resolve. Until it does, the only origin that answers is the Railway one:
#   VITE_API_URL=https://robotat2-production.up.railway.app
# VITE_API_URL=https://robotat.sa

# Server-side: absolute origin used to build emailed links (password reset, email
# verification). REQUIRED in production and must be https:// — the app refuses to
# boot without it. In development only, it falls back to the request's own origin.
# Never let production derive this from the request: the Host header is
# attacker-controlled, which would let anyone have a real reset token emailed to a
# victim pointing at their own domain. Same origin as VITE_API_URL above, because one
# Express process serves both the API and the client.
#
# Do NOT point this at robotat.sa until that domain resolves. A valid-looking https URL
# passes every check the app makes and the server boots perfectly happily, so the only
# symptom is that every password-reset and verification link mailed to a real customer
# leads nowhere — the one failure mode this variable exists to prevent, arrived at from
# the other direction. Keep it on the origin that answers until DNS is live.
# PUBLIC_APP_URL=https://robotat2-production.up.railway.app

# --- Native iOS push (APNs) ---
# All three of TEAM_ID, KEY_ID and PRIVATE_KEY are required together. With any of them
# missing, push is switched off entirely and status changes are logged instead of sent
# (the app still works; the customer just doesn't get a notification).
# Your 10-character Apple Developer Team ID (Membership page).
# APNS_TEAM_ID=
# The 10-character Key ID of the "Apple Push Notifications service (APNs)" key.
# APNS_KEY_ID=
# The contents of the AuthKey_XXXXXXXXXX.p8 file you downloaded when creating that key
# (Apple lets you download it exactly once). Environment variables cannot hold real
# newlines, so paste it as ONE line with the line breaks written as literal \n — the
# server converts them back. Keep the BEGIN/END lines:
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----\n"
# The iOS app's bundle identifier — this is the APNs topic. Defaults to com.nasl.robotat.
# APNS_BUNDLE_ID=com.nasl.robotat
# "production" talks to api.push.apple.com; anything else (the default) uses the
# sandbox. Leave it unset for development: builds run from Xcode and any development
# provisioning profile get SANDBOX device tokens, and sending those to the production
# host fails with BadDeviceToken. Set it to "production" only for App Store/TestFlight.
# APNS_ENV=production

# Comma-separated extra origins allowed to call the API cross-origin. The Capacitor
# origins (capacitor://localhost, ionic://localhost) are always allowed and need not
# be listed. Only needed if you host the web client on a different origin to the API.
# CORS_ORIGINS=https://app.robotat.example
