# Dependencies
node_modules/

# Secrets & environment (NEVER commit — contains DB password, session secret, API keys)
.env
.env.*
!.env.example

# Build output
dist/
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local Claude Code tooling (machine-specific launch config)
.claude/

# Capacitor — generated native iOS artifacts. The ios/ project itself IS committed
# (it holds Info.plist, icons and the launch screen); only these bits are build
# output. ios/.gitignore covers the rest. Do not re-run `npx cap add ios`.
/ios/App/App/public/
/ios/App/Pods/
/ios/App/build/
/ios/DerivedData/
*.xcworkspace/xcuserdata/
*.xcuserstate

